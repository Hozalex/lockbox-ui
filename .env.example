# --- Secrets provider ---
# Which secrets manager this deployment talks to: yandex (default) | huawei
# SECRETS_PROVIDER=yandex

# Logging level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Build version shown in UI corner (set at build time, e.g. git sha or tag)
# docker build --build-arg BUILD_VERSION=$(git rev-parse --short HEAD) .
NEXT_PUBLIC_BUILD_VERSION=dev

# --- Keycloak (optional — remove or leave empty to use OAuth-only mode) ---
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/your-realm
# KEYCLOAK_CLIENT_ID=lockbox-ui
# KEYCLOAK_CLIENT_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=  # openssl rand -base64 32

# --- YC Service Account (required when Keycloak is enabled) ---
# Authorized key JSON of the service account for YC API calls in Keycloak mode.
# Value: raw JSON or base64-encoded JSON from `yc iam key create --output sa-key.json`
# YC_SA_AUTHORIZED_KEY_JSON=

# --- Projects (intra-folder grouping / RBAC) ---
# Comma-separated registry of valid project names (lowercase). Secrets are
# grouped into tabs by their `project` label; only labels listed here count.
# Keycloak roles can grant per-project access: lockbox:<folder>:<project>:ro|rw
# LOCKBOX_PROJECTS=platform2,billing

# --- Huawei Cloud CSMS (when SECRETS_PROVIDER=huawei) ---
# Folders = values of the secret `environment` tag; projects = the `project` tag.
# HUAWEI_REGION=la-south-2
# HUAWEI_PROJECT_ID=                 # region project id (32 chars)
# HUAWEI_ENTERPRISE_PROJECT_ID=      # optional: create in / list only this enterprise project
# HUAWEI_ENVIRONMENTS=dev,stage,prod,infra
# HUAWEI_KMS_DEFAULTS=prod:csms-prod,infra:csms-infra   # others use csms/default
# HUAWEI_FREE_NAMING_ENVS=infra    # no forced "<env>-<project>-" name prefix here
# HUAWEI_SECRET_DELETION_DAYS=prod:30,*:7               # CSMS allows 7–30
# HUAWEI_VERSION_RETENTION_DAYS=prod:30,*:10            # expire_time set on "deleted" versions
# Auth — either Keycloak federation (preferred, no IAM keys)...
# HUAWEI_AUTH=oidc
# HUAWEI_IDP_ID=                     # identity provider id in Huawei IAM (X-Idp-Id)
# HUAWEI_OIDC_CLIENT_ID= / HUAWEI_OIDC_CLIENT_SECRET=   # default: KEYCLOAK_CLIENT_ID/SECRET
# ...or an IAM access key:
# HUAWEI_AUTH=aksk
# HUAWEI_ACCESS_KEY=
# HUAWEI_SECRET_KEY=
